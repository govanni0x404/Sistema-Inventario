generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Controla, por rol, si una sección de la app está habilitada. El rol "admin" nunca se consulta
// aquí (siempre tiene acceso total) para que un admin no pueda bloquearse a sí mismo.
model RolPermiso {
  id        String  @id @default(uuid())
  rolId     String
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  seccion   String
  permitido Boolean @default(true)

  @@unique([rolId, seccion])
  @@map("rol_permisos")
}

// Catálogo de roles asignables a un Usuario. Usuario.rolId y RolPermiso.rolId son FK reales
// hacia acá (no strings libres) — renombrar un rol se refleja solo en todo lo que lo
// referencia, sin necesidad de propagar el cambio a mano. "admin" es protegido: no se puede
// renombrar ni eliminar (todo el sistema compara contra el literal "admin").
model Rol {
  id        String       @id @default(uuid())
  nombre    String       @unique
  protegido Boolean      @default(false)
  activo    Boolean      @default(true)
  usuarios  Usuario[]
  permisos  RolPermiso[]

  @@map("roles")
}

// La clave del catálogo sobrevive a la ficha para respaldar referencias históricas.
model IdentidadProducto {
  id                    String @id @default(uuid())
  producto              Producto?
  cotizacionItems       CotizacionItem[]
  tomaInventarioItems   TomaInventarioItem[]

  @@map("identidades_producto")
}

model Producto {
  id              String            @id
  identidad       IdentidadProducto @relation(fields: [id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sku             String            @unique
  codigoBarras    String?           @unique
  nombre          String
  categoriaId     String?
  categoria       Categoria?        @relation(fields: [categoriaId], references: [id])
  subfamilia      String?
  tipoImpuesto    String            @default("iva19")
  ventaPublico    Boolean           @default(true)
  inventariable   Boolean           @default(true)
  mostrarPrecio   Boolean           @default(true)
  ventaVolumen    Boolean           @default(false)
  esPack          Boolean           @default(false)
  imagenExterna   String?
  foto            ProductoImagen?
  precioCompra    Decimal           @db.Decimal(10, 2)
  precioVenta     Decimal           @db.Decimal(10, 2)
  stockMinimo     Int               @default(0)
  unidadId        String
  unidad          Unidad            @relation(fields: [unidadId], references: [id])
  proveedorId     String?
  proveedor       Proveedor?        @relation(fields: [proveedorId], references: [id])
  activo          Boolean           @default(true)
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt
  ventaItems      VentaItem[]
  historialPrecios HistorialPrecio[]
  movimientos     MovimientoStock[]
  ventaEnEsperaItems VentaEnEsperaItem[]
  preciosLista    PrecioLista[]
  stockBodegas    StockBodega[]
  historialPreciosLista HistorialPrecioLista[]
  compraItems     OrdenCompraItem[]

  @@index([proveedorId])
  @@index([categoriaId])
  @@index([unidadId])
  @@map("productos")
}

model ProductoImagen {
  productoId   String   @id
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  mime         String
  datos        Bytes
  actualizadoEn DateTime @updatedAt

  @@map("productos_imagenes")
}

model HistorialPrecio {
  id                   String   @id @default(uuid())
  productoId           String
  producto             Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  precioCompraAnterior Decimal  @db.Decimal(10, 2)
  precioCompraNuevo    Decimal  @db.Decimal(10, 2)
  precioVentaAnterior  Decimal  @db.Decimal(10, 2)
  precioVentaNuevo     Decimal  @db.Decimal(10, 2)
  usuarioId            String?
  usuario              Usuario? @relation(fields: [usuarioId], references: [id])
  fecha                DateTime @default(now())

  @@index([productoId])
  @@map("historial_precios")
}

model MovimientoStock {
  id              String   @id @default(uuid())
  productoId      String
  producto        Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo            String   // "entrada" | "salida"
  origen          String   @default("manual") // "manual" | "venta" | "devolucion" | "transferencia" | "inventario" | "ajuste" | "compra" | "devolucion_compra" | "saldo_inicial"
  cantidad        Int
  stockResultante Int
  motivo          String?
  causaMerma      String?
  costoMerma      Decimal? @db.Decimal(10, 2)
  ventaId         String?
  venta           Venta?   @relation(fields: [ventaId], references: [id])
  usuarioId       String?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])
  bodegaId        String?
  bodega          Bodega?  @relation(fields: [bodegaId], references: [id])
  tomaInventarioId String?
  tomaInventario  TomaInventario? @relation(fields: [tomaInventarioId], references: [id], onDelete: SetNull)
  operacionCompraId String?
  operacionCompra OperacionCompra? @relation(fields: [operacionCompraId], references: [id], onDelete: Restrict)
  fecha           DateTime @default(now())

  @@index([productoId, fecha])
  @@index([fecha, id])
  @@index([ventaId])
  @@index([bodegaId])
  @@index([tomaInventarioId])
  @@index([operacionCompraId])
  @@map("movimientos_stock")
}

model TomaInventario {
  id            String            @id
  bodegaId      String
  bodegaNombre  String
  usuarioId     String
  usuarioNombre String
  tipo          String
  motivo        String
  items         TomaInventarioItem[]
  fecha         DateTime          @default(now())
  movimientos   MovimientoStock[]

  @@index([bodegaId, fecha, id])
  @@map("tomas_inventario")
}

model TomaInventarioItem {
  tomaId             String
  toma               TomaInventario @relation(fields: [tomaId], references: [id], onDelete: Cascade)
  posicion           Int
  // Conserva la identidad y la descripción del producto en el momento del conteo.
  productoReferencia String
  identidadProducto  IdentidadProducto @relation(fields: [productoReferencia], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nombre             String
  codigoBarras       String?
  unidad             String
  stockEsperado      Int
  stockContado       Int

  @@id([tomaId, posicion])
  @@unique([tomaId, productoReferencia])
  @@index([productoReferencia])
  @@map("toma_inventario_items")
}

// El saldo por bodega es la fuente de las existencias. El total se obtiene sumando las filas.
model StockBodega {
  id         String   @id @default(uuid())
  bodegaId   String
  bodega     Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cantidad   Int      @default(0)
  stockMinimo Int?

  @@unique([bodegaId, productoId])
  @@index([productoId])
  @@map("stock_bodega")
}

// La bodega "principal" es donde ocurren las ventas de Caja — está protegida, no se puede
// desactivar ni eliminar. Otras bodegas son ubicaciones adicionales de almacenamiento;
// el stock se mueve entre ellas por transferencia (ver bodegas.controller.js).
model Bodega {
  id          String            @id @default(uuid())
  nombre      String            @unique
  direccion   String?
  principal   Boolean           @default(false)
  activo      Boolean           @default(true)
  stocks      StockBodega[]
  movimientos MovimientoStock[]
  compras     OrdenCompra[]

  @@map("bodegas")
}

model Cliente {
  id             String          @id @default(uuid())
  nombre         String
  telefono       String?
  email          String?
  direccion      String?
  creadoEn       DateTime        @default(now())
  ventas         Venta[]
  ventasEnEspera VentaEnEspera[]
  cotizaciones   Cotizacion[]

  @@map("clientes")
}

model Proveedor {
  id        String     @id @default(uuid())
  nombre    String
  telefono  String?
  email     String?
  contacto  String?
  creadoEn  DateTime   @default(now())
  productos Producto[]
  compras   OrdenCompra[]

  @@map("proveedores")
}

enum EstadoCompra {
  borrador
  emitida
  parcial
  recibida
  cerrada
  anulada
}

model OrdenCompra {
  id              String @id @default(uuid())
  folio           Int @unique @default(autoincrement())
  estado          EstadoCompra @default(borrador)
  proveedorId     String
  proveedor       Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  proveedorNombre String
  bodegaId        String
  bodega          Bodega @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  bodegaNombre    String
  entregaEstimada DateTime? @db.Date
  nota            String?
  motivoCierre    String?
  creadoPor       String
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt
  items           OrdenCompraItem[]
  operaciones     OperacionCompra[]

  @@index([estado, folio])
  @@index([proveedorId])
  @@index([bodegaId])
  @@map("ordenes_compra")
}

model OrdenCompraItem {
  id             String @id @default(uuid())
  ordenId        String
  orden          OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  productoNombre String
  sku            String
  cantidad       Int
  costoUnitario  Decimal @db.Decimal(10, 2)
  operaciones    OperacionCompraItem[]

  @@unique([ordenId, productoId])
  @@index([productoId])
  @@map("orden_compra_items")
}

model OperacionCompra {
  id             String @id
  ordenId        String
  orden          OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  recepcionId    String?
  recepcion      OperacionCompra? @relation("DevolucionesCompra", fields: [recepcionId], references: [id], onDelete: Restrict)
  devoluciones   OperacionCompra[] @relation("DevolucionesCompra")
  documento      String
  nota           String?
  usuarioNombre  String
  fecha          DateTime @default(now())
  items          OperacionCompraItem[]
  movimientos    MovimientoStock[]

  @@index([ordenId, fecha])
  @@index([recepcionId])
  @@map("operaciones_compra")
}

model OperacionCompraItem {
  operacionId String
  operacion   OperacionCompra @relation(fields: [operacionId], references: [id], onDelete: Cascade)
  itemId      String
  item        OrdenCompraItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  cantidad    Int

  @@id([operacionId, itemId])
  @@index([itemId])
  @@map("operacion_compra_items")
}

model Categoria {
  id        String     @id @default(uuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("categorias")
}

model Unidad {
  id        String     @id @default(uuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("unidades")
}

// Catálogo de listas de precios (ej. "Público", "Mayorista"). Al crearse, el usuario
// decide si copia los precios actuales (punto de partida editable) o arranca vacía —
// eso lo resuelve el controller, no el schema. Un producto sin fila en PrecioLista para
// una lista dada usa Producto.precioVenta como respaldo.
model ListaPrecio {
  id        String                 @id @default(uuid())
  nombre    String                 @unique
  activo    Boolean                @default(true)
  creadoEn  DateTime               @default(now())
  precios   PrecioLista[]
  historial HistorialPrecioLista[]

  @@map("listas_precio")
}

model PrecioLista {
  id            String      @id @default(uuid())
  listaPrecioId String
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)
  productoId    String
  producto      Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  precio        Decimal     @db.Decimal(10, 2)

  @@unique([listaPrecioId, productoId])
  @@index([productoId])
  @@map("precios_lista")
}

// Historial de cambios de precio dentro de una lista — mismo patrón que HistorialPrecio
// para el precio base. precioAnterior/precioNuevo nulos = no tenía override antes / se
// quitó el override (volvió a usar el precio base de Producto).
model HistorialPrecioLista {
  id             String      @id @default(uuid())
  listaPrecioId  String
  listaPrecio    ListaPrecio @relation(fields: [listaPrecioId], references: [id])
  productoId     String
  producto       Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  precioAnterior Decimal?    @db.Decimal(10, 2)
  precioNuevo    Decimal?    @db.Decimal(10, 2)
  usuarioId      String?
  usuario        Usuario?    @relation(fields: [usuarioId], references: [id])
  fecha          DateTime    @default(now())

  @@index([listaPrecioId])
  @@index([productoId])
  @@map("historial_precios_lista")
}

model Cotizacion {
  id             String   @id
  folio          Int      @unique @default(autoincrement())
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  clienteNombre  String
  vigenteHasta   DateTime @db.Date
  fecha          DateTime @default(now())
  anuladaEn      DateTime?
  observaciones  String?
  usuarioNombre  String
  items          CotizacionItem[]
  descuento      Decimal  @db.Decimal(10, 2)
  venta          Venta?

  @@index([clienteId])
  @@index([vigenteHasta])
  @@map("cotizaciones")
}

model CotizacionItem {
  cotizacionId       String
  cotizacion         Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  posicion           Int
  // Los valores de la propuesta siguen disponibles cuando se elimina un producto del catálogo.
  productoReferencia String
  identidadProducto  IdentidadProducto @relation(fields: [productoReferencia], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nombre             String
  codigo             String?
  cantidad           Int
  precioUnitario     Decimal @db.Decimal(10, 2)
  descuento          Decimal @db.Decimal(10, 2)
  gravado            Boolean

  @@id([cotizacionId, posicion])
  @@index([productoReferencia])
  @@map("cotizacion_items")
}

model Venta {
  id          String            @id @default(uuid())
  fecha       DateTime          @default(now())
  clienteId   String?
  cliente     Cliente?          @relation(fields: [clienteId], references: [id])
  descuento   Decimal           @db.Decimal(10, 2) @default(0)
  total       Decimal           @db.Decimal(10, 2)
  tipoDocumento String          @default("interno")
  esCortesia    Boolean         @default(false)
  motivoCortesia String?
  pagos       VentaPago[]
  items       VentaItem[]
  usuarioId   String?
  usuario     Usuario?          @relation(fields: [usuarioId], references: [id])
  movimientos MovimientoStock[]
  turnoCajaId String?
  turnoCaja   TurnoCaja?        @relation(fields: [turnoCajaId], references: [id])
  devoluciones Devolucion[]
  claveIdempotencia String?
  huellaSolicitud   String?
  cotizacionId String?         @unique
  cotizacion   Cotizacion?     @relation(fields: [cotizacionId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, claveIdempotencia])
  @@index([clienteId])
  @@index([fecha])
  @@index([turnoCajaId])
  @@index([usuarioId])
  @@map("ventas")
}

// Una fila por cada forma de pago usada en el ticket (normalmente 1; hasta 2 si el
// cliente paga dividido, ej. mitad efectivo + mitad tarjeta). La suma de "monto" siempre
// debe igualar Venta.total — lo valida el backend al crear la venta.
model VentaPago {
  id         String  @id @default(uuid())
  ventaId    String
  venta      Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodoPago String
  monto      Decimal @db.Decimal(10, 2)

  @@unique([ventaId, metodoPago])
  @@map("venta_pagos")
}

model TipoTurno {
  id     String      @id @default(uuid())
  nombre String      @unique
  activo Boolean     @default(true)
  turnos TurnoCaja[]

  @@map("tipos_turno")
}

model Caja {
  id         String      @id @default(uuid())
  nombre     String      @unique
  fondoFijo  Decimal?    @db.Decimal(10, 2)
  principal  Boolean     @default(false)
  activa     Boolean     @default(true)
  turnos     TurnoCaja[]

  @@map("cajas")
}

model TurnoCaja {
  id                String    @id @default(uuid())
  cajaId            String
  caja              Caja      @relation(fields: [cajaId], references: [id])
  tipoTurnoId       String
  tipoTurno         TipoTurno @relation(fields: [tipoTurnoId], references: [id])
  montoInicial      Decimal   @db.Decimal(10, 2)
  montoContado      Decimal?  @db.Decimal(10, 2)
  montoEsperado     Decimal?  @db.Decimal(10, 2)
  notas             String?
  fechaApertura     DateTime  @default(now())
  fechaCierre       DateTime?
  usuarioAperturaId String?
  usuarioApertura   Usuario?  @relation("TurnosAbiertos", fields: [usuarioAperturaId], references: [id])
  usuarioCierreId   String?
  usuarioCierre     Usuario?  @relation("TurnosCerrados", fields: [usuarioCierreId], references: [id])
  ventas            Venta[]
  movimientosCaja   MovimientoCaja[]
  devoluciones      Devolucion[]

  @@index([fechaCierre])
  @@index([cajaId, fechaCierre])
  @@index([fechaApertura])
  @@map("turnos_caja")
}

// Entradas/salidas de efectivo de la caja que no vienen de una venta (pago a proveedor,
// ingreso de sencillo/cambio). Afectan el monto esperado del arqueo del turno: un
// "ingreso" lo suma, un "retiro" lo resta.
model MovimientoCaja {
  id          String    @id @default(uuid())
  turnoCajaId String
  turnoCaja   TurnoCaja @relation(fields: [turnoCajaId], references: [id])
  tipo        String    // "retiro" | "ingreso"
  monto       Decimal   @db.Decimal(10, 2)
  motivo      String
  usuarioId   String?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])
  fecha       DateTime  @default(now())
  // Opcionales: si el cliente envía una clave, un reintento devuelve el mismo movimiento.
  claveIdempotencia String?
  huellaSolicitud   String?

  @@unique([usuarioId, claveIdempotencia])
  @@index([turnoCajaId])
  @@map("movimientos_caja")
}

model VentaItem {
  id              String           @id @default(uuid())
  ventaId         String
  venta           Venta            @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId      String
  inventariable   Boolean          @default(true)
  producto        Producto         @relation(fields: [productoId], references: [id])
  cantidad        Int
  precioUnitario  Decimal          @db.Decimal(10, 2)
  // Las ventas anteriores a la captura del costo conservan null.
  costoUnitario   Decimal?         @db.Decimal(10, 2)
  descuento       Decimal          @db.Decimal(10, 2) @default(0)
  devolucionItems DevolucionItem[]

  @@index([ventaId])
  @@index([productoId])
  @@map("venta_items")
}

// El total de Venta queda inmutable (registro histórico); lo devuelto se calcula
// sumando estos registros, que son el origen de verdad de la auditoría de devoluciones.
model Devolucion {
  id        String           @id @default(uuid())
  ventaId   String
  venta     Venta            @relation(fields: [ventaId], references: [id])
  motivo    String?
  total     Decimal          @db.Decimal(10, 2)
  usuarioId String?
  usuario   Usuario?         @relation(fields: [usuarioId], references: [id])
  fecha     DateTime         @default(now())
  items     DevolucionItem[]
  // Turno abierto al momento de devolver y cómo se reembolsó: un reembolso en "efectivo"
  // sale de la caja de ese turno y se resta en su arqueo. null en cortesías (no hay reembolso).
  turnoCajaId     String?
  turnoCaja       TurnoCaja? @relation(fields: [turnoCajaId], references: [id])
  metodoReembolso String?    // "efectivo" | "tarjeta" | "transferencia"
  // Opcionales: si el cliente envía una clave, un reintento devuelve la misma devolución.
  claveIdempotencia String?
  huellaSolicitud   String?

  @@unique([usuarioId, claveIdempotencia])
  @@index([ventaId])
  @@index([turnoCajaId])
  @@index([fecha])
  @@map("devoluciones")
}

model DevolucionItem {
  id           String     @id @default(uuid())
  devolucionId String
  devolucion   Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  ventaItemId  String
  ventaItem    VentaItem  @relation(fields: [ventaItemId], references: [id])
  cantidad     Int
  subtotal     Decimal    @db.Decimal(10, 2)

  @@unique([devolucionId, ventaItemId])
  @@index([ventaItemId])
  @@map("devolucion_items")
}

model Usuario {
  id               String            @id @default(uuid())
  nombre           String
  email            String            @unique
  password         String
  rolId            String
  rol              Rol               @relation(fields: [rolId], references: [id])
  activo           Boolean           @default(true)
  // Se incrementa al cambiar/restablecer la contraseña o desactivar la cuenta: invalida
  // todos los tokens emitidos antes (el JWT lleva la versión con que se firmó).
  tokenVersion     Int               @default(0)
  creadoEn         DateTime          @default(now())
  ventas           Venta[]
  historialPrecios HistorialPrecio[]
  movimientosStock MovimientoStock[]
  devoluciones     Devolucion[]
  turnosAbiertos   TurnoCaja[]       @relation("TurnosAbiertos")
  turnosCerrados   TurnoCaja[]       @relation("TurnosCerrados")
  ventasEnEspera   VentaEnEspera[]
  movimientosCaja  MovimientoCaja[]
  auditoriasEjecutadas RegistroAuditoria[] @relation("AuditoriaEjecutor")
  auditoriasRecibidas  RegistroAuditoria[] @relation("AuditoriaAfectado")
  historialPreciosLista HistorialPrecioLista[]

  @@index([rolId])
  @@map("usuarios")
}

// Registro de eventos administrativos/seguridad que no tienen tabla dedicada propia
// (login, cambios de rol/estado de un usuario, reseteo de contraseña, cambios de
// permisos, renombre de rol, borrado de una lista de precios). Los eventos de alto
// volumen del negocio (ventas, stock, caja, precio base de producto) ya tienen su
// propia tabla (MovimientoStock, MovimientoCaja, HistorialPrecio, Devolucion) — este
// registro es solo para trazabilidad administrativa, no reemplaza esas.
model RegistroAuditoria {
  id                String   @id @default(uuid())
  accion            String
  usuarioId         String?
  usuario           Usuario? @relation("AuditoriaEjecutor", fields: [usuarioId], references: [id])
  usuarioAfectadoId String?
  usuarioAfectado   Usuario? @relation("AuditoriaAfectado", fields: [usuarioAfectadoId], references: [id])
  valorAnterior     String?
  valorNuevo        String?
  detalle           String?
  fecha             DateTime @default(now())

  @@index([usuarioId])
  @@index([usuarioAfectadoId, accion, fecha])
  @@index([accion])
  @@index([fecha])
  @@map("registro_auditoria")
}

// Snapshot de un carrito "enviado" desde Caja para retomarlo después (ej. mientras se
// atiende a otro cliente). No descuenta stock ni crea Venta hasta que se recupera y se
// cobra de verdad — es solo una foto de lo que había en el carrito.
model VentaEnEspera {
  id         String              @id @default(uuid())
  referencia String?
  clienteId  String?
  cliente    Cliente?            @relation(fields: [clienteId], references: [id])
  descuento  Decimal             @db.Decimal(10, 2) @default(0)
  tipoDocumento String           @default("interno")
  usuarioId  String?
  usuario    Usuario?            @relation(fields: [usuarioId], references: [id])
  creadoEn   DateTime            @default(now())
  items      VentaEnEsperaItem[]

  @@map("ventas_en_espera")
}

model VentaEnEsperaItem {
  id              String        @id @default(uuid())
  ventaEnEsperaId String
  ventaEnEspera   VentaEnEspera @relation(fields: [ventaEnEsperaId], references: [id], onDelete: Cascade)
  productoId      String
  producto        Producto      @relation(fields: [productoId], references: [id])
  cantidad        Int
  descuento       Decimal       @db.Decimal(10, 2) @default(0)

  @@index([ventaEnEsperaId])
  @@map("venta_en_espera_items")
}

// Datos del negocio que aparecen en el comprobante y en la app. Una sola fila (id = 1):
// cada instalación es de una sola tienda.
model Negocio {
  id            Int      @id @default(1)
  nombre        String
  rut           String?
  giro          String?
  direccion     String?
  telefono      String?
  email         String?
  mensajeTicket String?
  venderSinStock Boolean @default(false)
  agruparProductosCaja Boolean @default(true)
  documentoVentaDefecto String @default("interno")
  descuentoMaximoCaja Int @default(100)
  actualizadoEn DateTime @updatedAt

  @@map("negocio")
}
