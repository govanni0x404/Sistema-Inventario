DATABASE_URL="postgresql://usuario:password@localhost:5432/inventario_db"
PORT=4000
TZ="America/Santiago"
JWT_SECRET="change_me"
CORS_ORIGIN="http://localhost:5173"
# Define 1 si un único proxy de confianza recibe todo el tráfico antes de Express.
TRUST_PROXY_HOPS=0
# Opcional (recomendado en producción): clave que se pide en la pantalla de configuración
# inicial, para que nadie más que el dueño pueda crear el primer administrador.
# SETUP_CLAVE="una-clave-que-le-das-al-cliente"
